<div class="space-y-8">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold text-emerald-700">
        <%= @client.name %>
      </p>

      <h1 class="text-3xl font-bold text-slate-900">Projects</h1>

      <p class="mt-2 text-slate-600">
        Manage projects for this client.
      </p>
    </div>

    <%= link_to "Add Project",
          new_client_project_path(@client),
          class: "rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
  </div>

  <% if @projects.any? %>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-left">
        <thead class="bg-slate-100 text-sm uppercase text-slate-600">
          <tr>
            <th class="px-6 py-3">Name</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3">Deadline</th>
            <th class="px-6 py-3">Budget</th>
            <th class="px-6 py-3">Actions</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-200">
          <% @projects.each do |project| %>
            <tr class="hover:bg-slate-50">
              <td class="px-6 py-4 font-medium text-slate-900">
                <%= project.name %>
              </td>

              <td class="px-6 py-4 text-slate-700">
                <%= project.status %>
              </td>

              <td class="px-6 py-4 text-slate-700">
                <%= project.deadline || "No deadline" %>
              </td>

              <td class="px-6 py-4 text-slate-700">
                <%= project.budget.present? ? number_to_currency(project.budget) : "No budget" %>
              </td>

              <td class="px-6 py-4">
                <%= link_to "View",
                      client_project_path(@client, project),
                      class: "font-semibold text-emerald-700 hover:text-emerald-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <h2 class="text-xl font-semibold text-slate-900">No projects yet</h2>
      <p class="mt-2 text-slate-600">Add the first project for this client.</p>

      <%= link_to "Add first project",
            new_client_project_path(@client),
            class: "mt-6 inline-block rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
    </div>
  <% end %>

  <%= link_to "Back to Client",
        client_path(@client),
        class: "font-semibold text-slate-600 hover:text-slate-900" %>
</div>  
