<div class="min-h-screen bg-slate-100 px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-9xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl lg:grid-cols-2">
    <section class="relative hidden overflow-hidden bg-slate-950 p-12 text-white lg:flex lg:flex-col lg:justify-between">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="absolute -bottom-28 -left-20 h-80 w-80 rounded-full bg-blue-500/10 blur-3xl"></div>

      <div class="relative">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-emerald-400">
          AI Client Portal
        </p>

        <h1 class="mt-6 max-w-xl text-4xl font-bold leading-tight tracking-tight">
          Manage your client work with clarity and confidence.
        </h1>

        <p class="mt-5 max-w-lg text-base leading-7 text-slate-300">
          Create your account to organize clients, track projects, manage tasks,
          and keep important files in one secure workspace.
        </p>
      </div>

      <div class="relative mt-12 space-y-5">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-300">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" />
            </svg>
          </div>

          <div>
            <h2 class="font-semibold text-white">Client organization</h2>
            <p class="mt-1 text-sm leading-6 text-slate-200">
              Keep contacts, companies, notes, and client records easy to find.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-300">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" />
            </svg>
          </div>

          <div>
            <h2 class="font-semibold text-white">Project visibility</h2>
            <p class="mt-1 text-sm leading-6 text-slate-200">
              Monitor deadlines, budgets, progress, tasks, and uploaded files.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-300">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" />
            </svg>
          </div>

          <div>
            <h2 class="font-semibold text-white">Account-based privacy</h2>
            <p class="mt-1 text-sm leading-6 text-slate-200">
              Your clients, projects, tasks, and files remain scoped to your account.
            </p>
          </div>
        </div>
      </div>

      <p class="relative mt-12 text-xs text-slate-200">
        Built for freelancers and independent professionals.
      </p>
    </section>

    <section class="flex items-center p-6 sm:p-10 lg:p-14">
      <div class="mx-auto w-full max-w-md">
        <div>
          <p class="text-sm font-semibold text-emerald-700">
            Create your account
          </p>

          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
            Get started today
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600">
            Enter your account details below. You will be signed in automatically
            after your account is created.
          </p>
        </div>

        <% if @user.errors.any? %>
          <div
            class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4"
            role="alert"
            aria-labelledby="registration-error-heading"
          >
            <div class="flex gap-3">
              <div class="mt-0.5 text-red-600">
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 9v4m0 4h.01M10.3 3.7 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"
                  />
                </svg>
              </div>

              <div>
                <h3
                  id="registration-error-heading"
                  class="font-semibold text-red-900"
                >
                  Please correct the following:
                </h3>

                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <%= form_with model: @user,
                      url: registration_path,
                      class: "mt-8 space-y-6" do |form| %>
          <div>
            <%= form.label :email_address,
                           "Email address",
                           class: "block text-sm font-semibold text-slate-900" %>

            <%= form.email_field :email_address,
                                 required: true,
                                 autofocus: true,
                                 autocomplete: "email",
                                 placeholder: "you@example.com",
                                 class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
          </div>

          <div>
            <%= form.label :password,
                           class: "block text-sm font-semibold text-slate-900" %>

            <%= form.password_field :password,
                                    required: true,
                                    autocomplete: "new-password",
                                    maxlength: 72,
                                    placeholder: "Create a secure password",
                                    class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>

            <p class="mt-2 text-xs leading-5 text-slate-500">
              Use a strong password that is difficult for others to guess.
            </p>
          </div>

          <div>
            <%= form.label :password_confirmation,
                           "Confirm password",
                           class: "block text-sm font-semibold text-slate-900" %>

            <%= form.password_field :password_confirmation,
                                    required: true,
                                    autocomplete: "new-password",
                                    maxlength: 72,
                                    placeholder: "Enter your password again",
                                    class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
          </div>

          <%= form.submit "Create account",
                          class: "w-full cursor-pointer rounded-xl bg-emerald-600 px-4 py-3 font-semibold text-white shadow-lg shadow-emerald-600/20 transition hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-600/20" %>
        <% end %>

        <div class="mt-8 border-t border-slate-200 pt-6">
          <p class="text-center text-sm text-slate-600">
            Already have an account?

            <%= link_to "Sign in",
                        new_session_path,
                        class: "font-semibold text-emerald-700 transition hover:text-emerald-800 hover:underline" %>
          </p>
        </div>
      </div>
    </section>
  </div>
</div>