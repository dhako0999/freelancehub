<div class="mx-auto max-w-4xl">
  <div>
    <p class="text-sm font-semibold text-emerald-700">
      AI Assistant
    </p>

    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">
      Ask about your workspace
    </h1>

    <p class="mt-2 text-sm text-slate-600">
      Ask questions about your clients, projects, tasks, and deadlines.
    </p>
  </div>

  <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with url: assistant_path, 
                      method: :post,
                      data: { turbo: false } do |form| %>
      <%= form.label :question,
                     "Question",
                     class: "block text-sm font-semibold text-slate-900" %>

      <%= form.text_area :question,
                         value: @question,
                         rows: 4,
                         placeholder: "Which projects have deadlines coming up?",
                         class: "mt-2 w-full resize-none rounded-xl border border-slate-300 px-4 py-3 focus:border-emerald-600 focus:outline-none" %>

      <%= form.submit "Ask AI",
                      class: "mt-4 cursor-pointer rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white hover:bg-emerald-700" %>
    <% end %>
  </div>

  <% if @answer.present? %>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="font-semibold text-slate-900">
        Answer
      </h2>

      <div class="mt-3 whitespace-pre-wrap text-slate-700">
        <%= @answer %>
      </div>
    </div>
  <% end %>
</div>