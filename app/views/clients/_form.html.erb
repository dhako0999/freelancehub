<%= render "shared/errors", object: client %>

<%= form_with model: client, local: true do |form| %>
    <div class="mb-5">
        <%= form.label :name, class: "mb-2 block font-semibold text-slate-700" %>
        <%= form.text_field :name, class: "w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="mb-5">
        <%= form.label :email, class: "mb-2 block font-semibold text-slate-700" %>
        <%= form.email_field :email, class: "w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-emerald-500 focus:outline-none" %>
    </div>


    <div class="mb-5">
        <%= form.label :company, class: "mb-2 block font-semibold text-slate-700" %>
        <%= form.text_field :company, class: "w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-emerald-500 focus:outline-none" %>
    </div> 

    <div class="mb-5">
        <%= form.label :phone, class: "mb-2 block font-semibold text-slate-700" %>
        <%= form.text_field :phone, class: "w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="mb-6">
        <%= form.label :notes, class: "mb-2 block font-semibold text-slate-700" %>
        <%= form.text_area :notes, rows: 5, class: "w-full resize-none rounded-lg border border-slate-300 px-4 py-2 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="mb-6">
        <%= form.label :files,
                        "Client Files",
                        class: "mb-2 block font-semibold text-slate-700" %>

        <%= form.file_field :files,
                            multiple: true,
                            accept: ".pdf,.doc,.docx,.txt,.png,.jpg,.jpeg",
                            class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" %>

        <p class="mt-2 text-sm text-slate-500">
            Upload contracts, NDAs, intake documents, brand assets, or other client-level files.
        </p>
    </div>

   <%= form.submit class: "rounded-lg bg-emerald-600 px-6 py-3 font-semibold text-white hover:bg-emerald-700" %>

<% end %>