<div class="mx-auto max-w-lg">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm font-semibold text-emerald-700">
      Email Verification
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">
      Resend Verification Email
    </h1>

    <p class="mt-3 text-sm leading-6 text-slate-600">
      Enter the email address associated with your account and we’ll send you a new verification link.
    </p>

    <%= form_with url: resend_email_verification_path,
                  method: :post,
                  class: "mt-8 space-y-6" do |form| %>

      <div>
        <%= form.label :email_address,
                       "Email address",
                       class: "block text-sm font-semibold text-slate-900" %>

        <%= form.email_field :email_address,
                             required: true,
                             autocomplete: "email",
                             class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
      </div>

      <%= form.submit "Send Verification Email",
                      class: "w-full cursor-pointer rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      <%= link_to "Back to Sign In",
                  new_session_path,
                  class: "font-semibold text-emerald-700 hover:text-emerald-800" %>
    </p>
  </div>
</div>