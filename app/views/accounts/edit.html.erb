<div class="mx-auto max-w-2xl">
  <div>
    <p class="text-sm font-semibold text-emerald-700">
      Account
    </p>

    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">
      Edit account
    </h1>

    <p class="mt-2 text-sm text-slate-600">
      Update your profile information and account email address.
    </p>
  </div>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <% if @user.errors.any? %>
      <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4">
        <h2 class="font-semibold text-red-800">
          We could not update your account
        </h2>

        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user,
                  url: account_path,
                  method: :patch,
                  class: "space-y-6" do |form| %>
      <div>
        <%= form.label :first_name,
                      "First Name",
                      class: "block text-sm font-semibold text-slate-900" %>

        <%= form.text_field :first_name,
                            autocomplete: "given-name",
                            class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
      </div>

      <div>
        <%= form.label :last_name,
                      "Last Name",
                      class: "block text-sm font-semibold text-slate-900" %>

        <%= form.text_field :last_name,
                            autocomplete: "family-name",
                            class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
      </div>

      <div>
        <%= form.label :company_name,
                      "Company Name",
                      class: "block text-sm font-semibold text-slate-900" %>

        <%= form.text_field :company_name,
                            autocomplete: "organization",
                            class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
      </div>


      <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-semibold text-slate-950">
          Notification Preferences
        </h2>

        <p class="mt-1 text-sm text-slate-600">
          Choose whether you receive task reminder emails and how far in advance they should be sent.
        </p>

        <div class="mt-5">
          <label class="flex items-center gap-3">
            <%= form.check_box :task_reminders_enabled,
                              class: "h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" %>

            <span class="text-sm font-medium text-slate-800">
              Send me task reminder emails
            </span>
          </label>
        </div>

        <div class="mt-5">
          <%= form.label :reminder_days_before,
                        "Remind me before a task is due",
                        class: "block text-sm font-semibold text-slate-900" %>

          <%= form.select :reminder_days_before,
                          [
                            ["1 day before", 1],
                            ["2 days before", 2],
                            ["3 days before", 3],
                            ["7 days before", 7]
                          ],
                          {},
                          class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
        </div>
      </div>
      <div>
        <%= form.label :email_address,
                       "Email address",
                       class: "block text-sm font-semibold text-slate-900" %>

        <%= form.email_field :email_address,
                             required: true,
                             autocomplete: "email",
                             class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to "Cancel",
                    account_path,
                    class: "rounded-xl border border-slate-300 bg-white px-5 py-3 text-center text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>

        <%= form.submit "Save changes",
                        class: "cursor-pointer rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700" %>
      </div>
    <% end %>
  </section>
</div>
