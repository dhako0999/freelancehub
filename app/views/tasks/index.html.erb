<div class="space-y-8">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold text-emerald-700">
        <%= @project.name %>
      </p>  

      <h1 class="text-3xl font-bold text-slate-900">Tasks</h1>
      <p class="mt-2 text-slate-600">Manage tasks for this project.</p>
    </div>  

    <%=
       link_to "Add Task", new_client_project_task_path(@client, @project),
       class: "rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700"
      %>
  </div> 
  
  <% if @tasks.any? %>
     <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left">
          <thead class="bg-slate-50 text-sm uppercase text-slate-600">
            <tr>
               <th class="px-6 py-3">Title</th>
               <th class="px-6 py-3">Status</th>
               <th class="px-6 py-3">Due Date</th>
               <th class="px-6 py-3">Actions</th>
            </tr>  
          </thead>  

          <tbody class="divide-y divide-slate-200">
            <% @tasks.each do |task| %>
               <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-medium text-slate-900">
                  <%= task.title %>
                </td>
                <td class="px-6 py-4 font-medium text-slate-900"><%= task.status %></td>
                <td class="px-6 py-4 font-medium text-slate-900"><%= task.due_date || "No due date" %></td>
                <td class="px-6 py-4 font-medium text-slate-900"><%= link_to "View", client_project_task_path(@client, @project, task),
                    class: "font-semibold text-emerald-700 hover:text-emerald-900" %>
                </td>
               </tr> 
            <% end %>

          </tbody>  
        </table>  
     </div> 

  <% else %>
     <div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <h2 class="text-xl font-semibold text-slate-900">No tasks yet.</h2>
      <p class="mt-2 text-slate-600">Add the first task for this project.</p>

      <%= link_to "Add first task",
          new_client_project_task_path(@client, @project),
          class: "font-semibold text-slate-600 hover:text-slate-900" %>
     </div> 
  <% end %>

  <%=
    link_to "Back to Project",
    client_project_path(@client, @project),
    class: "font-semibold text-slate-600 hover:text-slate-900"
    %>
</div>  
