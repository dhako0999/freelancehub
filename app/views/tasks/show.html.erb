<div class="mx-auto max-w-3xl rounded-xl bg-white p-8 shadow-md">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold text-emerald-700"><%= @project.name %></p>
      <h1 class="text-3xl font-bold text-slate-900"><%= @task.title %></h1>
    </div>

    <%= link_to "Back to Project", client_project_path(@client, @project), class: "font-semibold text-emerald-700 hover:text-emerald-900" %>
  </div>

  <div class="space-y-6">
    <div>
      <p class="text-sm font-semibold uppercase text-slate-500">Status</p>
      <p class="mt-1 text-slate-900"><%= @task.status %></p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase text-slate-500">Due Date</p>
      <p class="mt-1 text-slate-900"><%= @task.due_date || "Not specified" %></p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase text-slate-500">Description</p>
      <p class="mt-1 whitespace-pre-line text-slate-900"><%= @task.description %></p>
    </div>
  </div>

  <div class="mt-8 flex gap-4">
    <%= link_to "Edit Task", edit_client_project_task_path(@client, @project, @task), class: "rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>

    <%= button_to "Delete Task",
          client_project_task_path(@client, @project, @task),
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this task?" },
          class: "rounded-lg bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-700" %>
  </div>
</div>
