<div class="space-y-8">
  <div>
    <p class="text-sm font-semibold text-emerald-700">
      Overview
    </p>  

    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">
      Dashboard
    </h1>  

    <p class="mt-2 text-sm text-slate-600">
      Review your clients, projects, tasks, and upcoming deadlines.
    </p>  
  </div>

  <div class="flex flex-col gap-3 sm:flex-row">
    <%= link_to "View clients",
                clients_path,
                class: "rounded-xl border border-slate-300 bg-white px-5 py-3 text-center text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 hover:text-slate-950" %>

    <%= link_to "Add client",
                new_client_path,
                class: "rounded-xl bg-emerald-600 px-5 py-3 text-center text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700" %>
  </div>

  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-bold text-slate-950">
            Upcoming tasks
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Incomplete tasks due within the next seven days.
          </p>
        </div>
      </div>

      <% if @upcoming_tasks.any? %>
        <div class="divide-y divide-slate-100">
          <% @upcoming_tasks.each do |task| %>
            <div class="flex flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <%= link_to task.title,
                            client_project_task_path(
                              task.project.client,
                              task.project,
                              task
                            ),
                            class: "font-semibold text-slate-950 transition hover:text-emerald-700" %>

                <p class="mt-1 text-sm text-slate-500">
                  <%= task.project.client.name %>
                  <span aria-hidden="true">•</span>
                  <%= task.project.name %>
                </p>
              </div>

              <div class="sm:text-right">
                <p class="text-sm font-semibold text-slate-700">
                  Due <%= task.due_date.strftime("%B %-d, %Y") %>
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  <%= task.priority.humanize %> priority
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12l4 4L19 6"
              />
            </svg>
          </div>

          <h3 class="mt-4 font-semibold text-slate-950">
            No upcoming tasks
          </h3>

          <p class="mt-2 text-sm text-slate-500">
            You do not have any incomplete tasks due in the next seven days.
          </p>
        </div>
      <% end %>
    </section>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">Clients</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= @total_clients %></p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">Projects</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= @total_projects %></p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">Open Tasks</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= @open_tasks %></p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">Completed Tasks</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= @completed_tasks %></p>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-red-200 bg-red-50 p-5">
      <p class="text-sm font-semibold text-red-700">Overdue Tasks</p>
      <p class="mt-2 text-3xl font-bold text-red-900"><%= @overdue_tasks %></p>
    </div>

    <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
      <p class="text-sm font-semibold text-amber-700">Due Soon</p>
      <p class="mt-2 text-3xl font-bold text-amber-900"><%= @due_soon_tasks %></p>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">Recent Clients</h2>

      <% if @recent_clients.any? %>
        <div class="mt-4 space-y-3">
          <% @recent_clients.each do |client| %>
            <div class="rounded-lg bg-slate-50 p-3">
              <%= link_to client.name, client_path(client), class: "font-semibold text-slate-900 hover:text-emerald-700" %>
              <p class="text-sm text-slate-600"><%= client.company %></p>
            </div>
          <% end %>
        </div>

      <% else %>
        <div class="px-6 py-10 text-center">
          <h3 class="font-semibold text-slate-950">
            No clients yet
          </h3> 
          
          <p class="mt-2 text-sm text-slate-500">
            Add your first client to begin organizing projects and tasks.
          </p> 
          
          <%= link_to "Add your first client",
                      new_client_path,
                      class: "mt-5 inline-flex rounded-lg bg-emerald-600 px-4 py-3 text-white text-sm font-semibold transition hover:bg-emerald-700"
                %>
        </div>  

      <% end %>
      
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">Recent Projects</h2>

      <% if @recent_projects.any? %>
        <div class="mt-4 space-y-3">
          <% @recent_projects.each do |project| %>
            <div class="rounded-lg bg-slate-50 p-3">
              <%= link_to project.name,
                    client_project_path(project.client, project),
                    class: "font-semibold text-slate-900 hover:text-emerald-700" %>
              <p class="text-sm text-slate-600"><%= project.client.name %></p>
            </div>
          <% end %>
        </div>
        <% else %>
          <div class="px-6 py-10 text-center">
            <h3 class="font-semibold text-slate-950">
              No projects yet
            </h3>

            <p class="mt-2 text-sm text-slate-500">
              Open a client and create a project to begin tracking work.
            </p>

            <%= link_to "View clients",
                        clients_path,
                        class: "mt-5 inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
          </div>
        <% end %>
      
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">Recent Tasks</h2>

      <% if @recent_tasks.any? %>
        <div class="mt-4 space-y-3">
          <% @recent_tasks.each do |task| %>
            <div class="rounded-lg bg-slate-50 p-3">
              <%= link_to task.title,
                    client_project_task_path(task.project.client, task.project, task),
                    class: "font-semibold text-slate-900 hover:text-emerald-700" %>

              <div class="mt-2 flex flex-wrap gap-2">
                <%= status_badge(task.status) %>
                <%= priority_badge(task.priority) %>
              </div>

              <p class="mt-2 text-sm text-slate-600">
                <%= task.project.name %>
              </p>
            </div>
          <% end %>
        </div>
      <% else %>
         <div class="px-6 py-10 text-center">
          <h3 class="font-semibold text-slate-600">
            No projects yet
          </h3>  

          <p class="mt-2 text-sm text-slate-600">
            Open a client and create a project to begin tracking work.
          </p>  

          <%= link_to "View Clients",
                      clients_path,
                      class: "mt-5 inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                      %>
         </div> 
      <% end %>
      
    </div>
  </div>
</div> 
