<div class="min-h-screen bg-slate-100 px-4 py-8 sm:px-6 lg:flex lg:items-center lg:px-8">
  <div class="mx-auto grid w-full max-w-6xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl lg:grid-cols-2">

    <!-- Left branding panel -->
    <section class="relative overflow-hidden bg-slate-950 p-6 text-white sm:p-10 lg:flex lg:min-h-[700px] lg:flex-col lg:justify-between lg:p-14">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="absolute -bottom-28 -left-20 h-80 w-80 rounded-full bg-blue-500/10 blur-3xl"></div>

      <div class="relative">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-emerald-400">
          AI Client Portal
        </p>

        <h1 class="mt-6 max-w-xl text-4xl font-bold leading-tight tracking-tight">
          Welcome back to your client workspace.
        </h1>

        <p class="mt-5 max-w-lg text-base leading-7 text-slate-300">
          Sign in to manage your clients, monitor projects, organize tasks,
          and access your important project files.
        </p>
      </div>

      <div class="relative mt-12 space-y-5">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-300">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12l4 4L19 6"
              />
            </svg>
          </div>

          <div>
            <h2 class="font-semibold text-white">
              Centralized client records
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-200">
              Keep client details, companies, contact information, and notes
              organized in one place.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-300">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12l4 4L19 6"
              />
            </svg>
          </div>

          <div>
            <h2 class="font-semibold text-white">
              Clear project tracking
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-200">
              Review project status, deadlines, budgets, tasks, and progress.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-300">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12l4 4L19 6"
              />
            </svg>
          </div>

          <div>
            <h2 class="font-semibold text-white">
              Account-based privacy
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-200">
              Your workspace is separated from the data belonging to other users.
            </p>
          </div>
        </div>
      </div>

      <p class="relative mt-12 text-xs text-slate-200">
        Built for freelancers and independent professionals.
      </p>
    </section>

    <!-- Right sign-in panel -->
    <section class="p-6 sm:p-10 lg:flex lg:items-center lg:p-14">
      <div class="mx-auto w-full max-w-md">
        <div>
          <p class="text-sm font-semibold text-emerald-700">
            Account access
          </p>

          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
            Sign in to your account
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600">
            Enter your email address and password to continue to your workspace.
          </p>
        </div>

        <% if flash[:alert].present? %>
          <div
            class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4"
            role="alert"
          >
            <div class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-red-600"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v4m0 4h.01M10.3 3.7 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"
                />
              </svg>

              <p class="text-sm font-medium text-red-800">
                <%= flash[:alert] %>
              </p>
            </div>
          </div>
        <% end %>

        <% if flash[:notice].present? %>
          <div
            class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4"
            role="status"
          >
            <div class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-emerald-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 12l4 4L19 6"
                />
              </svg>

              <p class="text-sm font-medium text-emerald-800">
                <%= flash[:notice] %>
              </p>
            </div>
          </div>
        <% end %>

        <%= form_with url: session_path,
                      class: "mt-8 space-y-6" do |form| %>
          <div>
            <%= form.label :email_address,
                           "Email address",
                           class: "block text-sm font-semibold text-slate-900" %>

            <%= form.email_field :email_address,
                                 required: true,
                                 autofocus: true,
                                 autocomplete: "username",
                                 placeholder: "you@example.com",
                                 value: params[:email_address],
                                 class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
          </div>

          <div>
            <div class="flex items-center justify-between gap-4">
              <%= form.label :password,
                             class: "block text-sm font-semibold text-slate-900" %>

              <%= link_to "Forgot password?",
                          new_password_path,
                          class: "text-sm font-semibold text-emerald-700 transition hover:text-emerald-800 hover:underline" %>
            </div>

            <%= form.password_field :password,
                                    required: true,
                                    autocomplete: "current-password",
                                    maxlength: 72,
                                    placeholder: "Enter your password",
                                    class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/10" %>
          </div>

          <%= form.submit "Sign in",
                          class: "w-full cursor-pointer rounded-xl bg-emerald-600 px-4 py-3 font-semibold text-white shadow-lg shadow-emerald-600/20 transition hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-600/20" %>
        <% end %>

        <div class="mt-8 border-t border-slate-200 pt-6">
          <p class="text-center text-sm text-slate-600">
            Don’t have an account?

            <%= link_to "Create an account",
                        new_registration_path,
                        class: "font-semibold text-emerald-700 transition hover:text-emerald-800 hover:underline" %>
          </p>
        </div>
      </div>
    </section>
  </div>
</div>