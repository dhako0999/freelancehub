<div class="mx-auto max-w-4xl">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold text-slate-950">
      AI Conversations
    </h1>

    <%= button_to "New Conversation",
                  ai_conversations_path,
                  method: :post,
                  class: "rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white" %>
  </div>

  <div class="mt-8 space-y-3">
    <% @conversations.each do |conversation| %>
      <%= link_to ai_conversation_path(conversation),
                  class: "block rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50" do %>

        <p class="font-semibold text-slate-900">
          <%= conversation.title %>
        </p>

        <p class="mt-1 text-sm text-slate-500">
          Updated <%= time_ago_in_words(conversation.updated_at) %> ago
        </p>
      <% end %>
    <% end %>
  </div>
</div>