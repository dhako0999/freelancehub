<div class="mx-auto max-w-4xl">
  <div class="flex items-center justify-between gap-4">
    <%= form_with model: @conversation,
                  url: ai_conversation_path(@conversation),
                  method: :patch,
                  class: "flex flex-1 items-center gap-3" do |form| %>

      <%= form.text_field :title,
                          class: "w-full max-w-xl rounded-xl border border-slate-300 px-4 py-2 text-2xl font-bold text-slate-950",
                          maxlength: 100 %>

      <%= form.submit "Rename",
                      class: "rounded-xl bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-800" %>
    <% end %>

    <%= button_to "Delete",
                  ai_conversation_path(@conversation),
                  method: :delete,
                  data: {
                    turbo_confirm: "Are you sure you want to delete this conversation?"
                  },
                  class: "rounded-xl bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-700" %>
  </div>

  <div class="mt-8 space-y-4">
    <% @messages.each do |message| %>
      <div class="<%= message.role == "user" ? "ml-auto bg-emerald-600 text-white" : "mr-auto bg-slate-100 text-slate-900" %> max-w-2xl rounded-2xl px-5 py-4">
        <%= markdown(message.content) %>
      </div>
    <% end %>
  </div>

  <div data-controller="suggested-prompt">

      <% suggested_prompts = ai_suggested_prompts(Current.user) %>

      <div class="mb-6">
        <p class="mb-3 text-sm font-semibold text-slate-600">
          Suggested prompts
        </p>

        <div class="flex flex-wrap gap-2">
          <% suggested_prompts.each do |prompt| %>
            <button
              type="button"
              class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
              data-prompt="<%= prompt %>"
              data-action="click->suggested-prompt#select"
            >
              <%= prompt %>
            </button>
          <% end %>
        </div>
      </div>

      <div class="mt-8">
        <%= form_with url: ai_conversation_ai_messages_path(@conversation),
                      method: :post do |form| %>

          <%= form.text_area :content,
                            rows: 4,
                            placeholder: "Ask a follow-up question...",
                            class: "w-full rounded-xl border border-slate-300 px-4 py-3",
                            data: {
                              suggested_prompt_target: "input"
                            } %>

          <%= form.submit "Send",
                          class: "mt-3 rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white" %>
        <% end %>
      </div>

    </div>
  

  
</div>